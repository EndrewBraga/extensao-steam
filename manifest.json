{
  "manifest_version": 3,
  "name": "Extensão Steam",
  "version": "0.6.0",
  "description": "Mostra o preço dos jogos da Steam e o total gasto na sua conta.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icone16.png",
    "32": "icons/icone32.png",
    "48": "icons/icone48.png",
    "128": "icons/icone128.png"
  },
  "action": {
    "default_title": "Gastos na Steam",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icone16.png",
      "32": "icons/icone32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://store.steampowered.com/*"],
      "js": ["resumo.js", "content.js", "atualizar.js"]
    },
    {
      "matches": ["https://store.steampowered.com/account/history/*"],
      "js": ["gastos.js"]
    }
  ]
}
