{
  "manifest_version": 3,
  "name": "Gastos em Jogos",
  "version": "0.12.0",
  "description": "Veja quanto você gastou em jogos, somando suas lojas, direto no navegador. Não é afiliada a nenhuma loja.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://secure.nuuvem.com/*",
    "https://accounts.epicgames.com/*",
    "https://web.np.playstation.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icone16.png",
    "32": "icons/icone32.png",
    "48": "icons/icone48.png",
    "128": "icons/icone128.png"
  },
  "action": {
    "default_title": "Gastos em Jogos",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icone16.png",
      "32": "icons/icone32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://store.steampowered.com/*"
      ],
      "js": [
        "resumo.js",
        "content.js",
        "atualizar.js"
      ]
    },
    {
      "matches": [
        "https://store.steampowered.com/account/history/*"
      ],
      "js": [
        "gastos.js"
      ]
    }
  ]
}
